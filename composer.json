{
    "name": "bakslash/static-site-bundle",
    "description": "Generate a static site by prerendering Symfony routes.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "bundle", "static-site", "ssg", "prerender"],
    "require": {
        "php": ">=8.3",
        "psr/container": "^1.1 || ^2.0",
        "sensiolabs/minify-bundle": "dev-feat/html-support as 1.3.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/filesystem": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Bakslash\\StaticSiteBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bakslash\\StaticSiteBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bakslashHQ/minify-bundle"
        }
    ]
}
