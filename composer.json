{
    "name": "bakslash/static-site-bundle",
    "description": "Generate a static site by prerendering Symfony routes.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "bundle", "static-site", "ssg", "prerender"],
    "require": {
        "php": ">=8.3",
        "league/flysystem": "^3.0",
        "league/flysystem-local": "^3.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/service-contracts": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "sensiolabs/minify-bundle": "^1.3",
        "symfony/filesystem": "^7.4 || ^8.0"
    },
    "conflict": {
        "sensiolabs/minify-bundle": "<1.3"
    },
    "suggest": {
        "league/flysystem-bundle": "Configure a non-local storage backend (S3, FTP, ...) and reference it from the \"storage\" option",
        "sensiolabs/minify-bundle": "Enables minification of generated HTML and XML pages"
    },
    "autoload": {
        "psr-4": {
            "Bakslash\\StaticSiteBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bakslash\\StaticSiteBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
